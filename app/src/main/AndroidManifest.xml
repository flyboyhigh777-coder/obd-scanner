<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Bluetooth. С Android 12 (API 31) старые BLUETOOTH/BLUETOOTH_ADMIN заменены
      на BLUETOOTH_CONNECT и BLUETOOTH_SCAN, которые спрашиваются в рантайме -
      поэтому старые объявлены с maxSdkVersion="30".
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Сканирование нужно для BLE-адаптеров: они, в отличие от классических
      ELM327, обычно не сопрягаются заранее и в списке сопряжённых устройств не
      видны. neverForLocation говорит системе, что по результатам поиска
      местоположение не определяется - тогда на Android 12+ геопозиция не
      спрашивается вовсе.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <!--
      На Android 8-11 сканирование BLE на уровне платформы невозможно без
      разрешения на точное местоположение: так устроен Android, потому что по
      Bluetooth-маячкам можно определять положение. Приложению геопозиция не
      нужна, никуда не отправляется и спрашивается только при нажатии "искать
      BLE" на этих версиях - отсюда maxSdkVersion="30".
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Wi-Fi адаптеры ELM327 поднимают свою точку доступа: связь с ними - обычный TCP-сокет. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Ничего из железа приложение не требует обязательно - это важно не для
      телефонов, а для головных устройств в машине (Teyes и подобные на
      Android). У них набор железа урезанный, и любая строка uses-feature без
      required="false" превращается в запрет на установку.

      Отдельная ловушка - местоположение. Объявленное выше право
      ACCESS_FINE_LOCATION само по себе подразумевает, что устройству нужны
      android.hardware.location и location.gps. У магнитолы GPS-приёмник есть
      не всегда (а на дешёвых моделях его нет совсем), и без явного
      required="false" приложение туда просто не поставится - при том, что
      местоположение ему не нужно вовсе и спрашивается только ради поиска
      BLE-адаптеров на Android 8-11.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <application
        android:name=".ObdApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ObdScanner">
        <!--
          Головное устройство держит приложение в своей оболочке и может менять
          ему размер; без этого некоторые прошивки открывают его в маленьком
          окне с чёрными полями.
        -->
        <meta-data
            android:name="android.max_aspect"
            android:value="4.0" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:theme="@style/Theme.ObdScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Отправка выгруженного CSV в другое приложение (почта, мессенджер). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
